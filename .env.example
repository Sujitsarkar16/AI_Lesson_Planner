# Browser-visible configuration
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
# Use https://curriculaiq.in in production; use your local Vite origin for development.
VITE_APP_URL=https://curriculaiq.in
VITE_ENVIRONMENT=development

# Server-only configuration — never prefix these names with VITE_
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
# API runtime credential. The API account receives only the `stripe_api_runtime` role.
MONGODB_URI=mongodb+srv://<api-username>:<api-password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_lesson_planner
STUDENT_SESSION_SECRET=replace_with_a_long_random_secret

# Billing configuration — server-only, set real values in the deployment environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
AUTH0_ADMIN_CLAIM=
AUTH0_ADMIN_VALUE=

# Separate least-privilege runtime credentials. Do not reuse the API URI.
WORKER_MONGODB_URI=
AUDIT_WRITER_MONGODB_URI=

# Provisioning-only credential. Never expose it to the API, worker, or browser.
MONGODB_ADMIN_URI=
MONGODB_AUTH_DB=admin
# Optional: `npm run db:setup-roles` creates/updates all three users when all six values are supplied.
MONGODB_API_USERNAME=
MONGODB_API_PASSWORD=
MONGODB_WORKER_USERNAME=
MONGODB_WORKER_PASSWORD=
MONGODB_AUDIT_WRITER_USERNAME=
MONGODB_AUDIT_WRITER_PASSWORD=
